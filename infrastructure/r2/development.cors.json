{
  "rules": [
    {
      "id": "mailflow-browser-upload",
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "http://localhost:3001",
          "http://localhost:3010",
          "http://127.0.0.1:3000",
          "http://127.0.0.1:3001",
          "http://127.0.0.1:3010",
          "http://[::1]:3000",
          "http://[::1]:3001",
          "http://[::1]:3010",
          "https://localhost:3000",
          "https://localhost:3001",
          "https://localhost:3010",
          "https://127.0.0.1:3000",
          "https://127.0.0.1:3001",
          "https://127.0.0.1:3010",
          "https://[::1]:3000",
          "https://[::1]:3001",
          "https://[::1]:3010"
        ],
        "methods": ["PUT"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 300
    }
  ]
}
