{
  "rules": [
    {
      "id": "mailflow-browser-upload",
      "allowed": {
        "origins": [
          "https://app-staging.mailflow-ai.online",
          "https://*.app-staging.mailflow-ai.online"
        ],
        "methods": ["PUT"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 300
    }
  ]
}
