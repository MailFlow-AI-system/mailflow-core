{
  "image": "clamav/clamav:1.4.6-debian13-slim",
  "privatePort": 3310,
  "region": "us-east4-eqdc4a",
  "memoryGB": 4,
  "vCPUs": 2,
  "variables": {
    "CLAMD_CONF_TCPAddr": "::",
    "CLAMD_CONF_TCPSocket": "3310",
    "CLAMD_CONF_AlertExceedsMax": "yes",
    "CLAMD_CONF_AlertEncrypted": "yes",
    "CLAMD_CONF_MaxScanSize": "100M",
    "CLAMD_CONF_MaxFileSize": "20M",
    "CLAMD_CONF_MaxRecursion": "10",
    "CLAMD_CONF_MaxFiles": "10000",
    "CLAMD_CONF_MaxScanTime": "25000",
    "CLAMD_CONF_StreamMaxLength": "10M",
    "CLAMD_CONF_MaxThreads": "2",
    "CLAMD_CONF_ConcurrentDatabaseReload": "no",
    "FRESHCLAM_CHECKS": "12"
  }
}
