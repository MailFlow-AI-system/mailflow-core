APP_ENV=development
DATABASE_URL=postgresql://mailflow:mailflow@localhost:5432/mailflow
# Direct connection to the same database; migrations never fall back to DATABASE_URL.
DIRECT_URL=postgresql://mailflow:mailflow@localhost:5432/mailflow
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
API_DOCS_ENABLED=true
# Discovery is dark until migrations, the restricted database role and Web rollout are approved.
WORKSPACE_READ_ENABLED=false
# Remote selection and generic-entry preference resolution.
# Requires reads, HTTPS origins and WORKSPACE_WEB_BASE_ORIGIN matching WEB_APP_URL.
# Use an isolated Web subdomain, never the shared root domain.
WORKSPACE_SWITCHING_ENABLED=false
# Phase 3 remains local-only; never enable this in staging/production.
WORKSPACE_LOCAL_SWITCHING_ENABLED=false
# This local-only flag also installs authenticated preference resolution at workspace-entry.
# Phase 2: defaults stay off until Core + Site + worker rollout is approved.
WORKSPACE_ONBOARDING_ENABLED=false
WORKSPACE_EMAIL_DELIVERY_ENABLED=false
WORKSPACE_SIGNUP_CUTOVER_ENABLED=false
# Required only with onboarding enabled; exact origin, not a wildcard or /login URL.
# Local test example only. Confirm each real environment's tenant base separately.
# WORKSPACE_WEB_BASE_ORIGIN=http://workspace.test:3001
SERVICE_VERSION=development
BETTER_AUTH_URL=http://localhost:8080
SITE_URL=http://localhost:4321
# Development auth also accepts localhost, 127.0.0.1 and [::1] on other ports.
# Staging and production require the configured exact origins.
WEB_APP_URL=http://localhost:3000
# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-minimum-secret
# Use a sender address on a verified custom Resend domain in every environment.
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=noreply@mailflow-ai.online
# Optional private OpenTelemetry Collector endpoint. Leave unset for a safe local no-op.
# Copy the exact private domain from Railway Settings > Networking for the target environment.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<actual-private-domain>:4318
# OTEL_TRACE_SAMPLE_RATE=0.1
# OTEL_SERVICE_INSTANCE_ID=mailflow-core-api-local
# Private, environment-specific object storage credentials; never expose these to browsers.
R2_ACCOUNT_ID=replace-with-account-id
R2_BUCKET_NAME=mailflow-attachments-development
R2_ACCESS_KEY_ID=replace-with-access-key
R2_SECRET_ACCESS_KEY=replace-with-secret-key
# For local MinIO only. Leave unset for Cloudflare R2.
# R2_ENDPOINT=http://127.0.0.1:9000
# Private clamd service with fresh signatures; scanning fails closed when unavailable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
