{
  "name": "mailflow-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#modules/*": {
      "development": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "dev": "infisical run --env=dev --path=/mailflow-core -- tsx watch --conditions=development src/entrypoints/api.ts",
    "dev:worker": "infisical run --env=dev --path=/mailflow-core -- tsx watch --conditions=development src/entrypoints/worker.ts",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/entrypoints/api.js",
    "start:worker": "node --enable-source-maps dist/entrypoints/worker.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "observability:collector:validate": "bash scripts/observability/validateCollector.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "db:generate:identity-workspace": "infisical run --env=dev --path=/mailflow-core -- drizzle-kit generate --config=database/configs/identityWorkspace.ts",
    "db:generate:mail": "infisical run --env=dev --path=/mailflow-core -- drizzle-kit generate --config=database/configs/mail.ts",
    "db:migrate": "infisical run --env=dev --path=/mailflow-core -- tsx src/entrypoints/migrate.ts",
    "db:migrate:identity-workspace": "infisical run --env=dev --path=/mailflow-core -- tsx src/entrypoints/migrate.ts identity-workspace",
    "db:migrate:mail": "infisical run --env=dev --path=/mailflow-core -- tsx src/entrypoints/migrate.ts mail",
    "db:check:identity-workspace": "infisical run --env=dev --path=/mailflow-core -- drizzle-kit check --config=database/configs/identityWorkspace.ts",
    "db:check:mail": "infisical run --env=dev --path=/mailflow-core -- drizzle-kit check --config=database/configs/mail.ts",
    "db:seed:mail": "infisical run --env=dev --path=/mailflow-core -- tsx --conditions=development src/modules/mail/seed/run.ts",
    "email:dev": "email dev --dir src/modules/identityWorkspace/accountEmails/templates --port 4000"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "better-auth": "1.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "react": "^19",
    "react-dom": "^19",
    "react-email": "^6.11.0",
    "resend": "^6.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@react-email/ui": "6.11.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
